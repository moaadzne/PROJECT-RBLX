[0m$ [0mcd "/Users/admin/Documents/claude code/tide-rush" && python3 - <<'EOF'
import math
COVE=70; CLIFF_OUTER=74; CLIFF_H=30; BREACH=10; SEA_Y=0
N=8
angs=[(i-1)*2*math.pi/N for i in range(1,N+1)]
def in_breach(x,z,r):
    if r<0.01: return False
    a=math.atan2(z,x); ha=math.atan2(BREACH,r)
    return any(abs(math.atan2(math.sin(a-la),math.cos(a-la)))<ha for la in angs)
def height_at(x,z):
    r=math.hypot(x,z)
    if r>300: return SEA_Y-3
    if r<COVE:
        t=r/COVE; return SEA_Y-2+t*2
    if r<=CLIFF_OUTER:
        return SEA_Y+1 if in_breach(x,z,r) else SEA_Y+CLIFF_H
    roll=math.sin(x*0.02)*2+math.cos(z*0.018)*2
    base=SEA_Y+2+roll
    base=min(base,16-2); base=max(base,-2+1)
    if r>300:
        t=(r-300)/150; base=base*(1-t)+(SEA_Y-3)*t
    return base
print("=== la crete existe-t-elle vraiment ? ===")
for deg in range(0,360,10):
    a=math.radians(deg); r=(COVE+CLIFF_OUTER)/2
    x,z=math.cos(a)*r,math.sin(a)*r
    print(f"  {deg:3}deg  h={height_at(x,z):5.1f}  breach={in_breach(x,z,r)}")
EOF
