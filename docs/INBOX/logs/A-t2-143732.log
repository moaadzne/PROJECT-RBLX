My simulation was wrong, not the Lua. In Lua `""` is truthy (only `nil`/`false` are falsy), so `mutations[1]` passes the guard; Python's `""` is falsy. I redo it with Lua semantics.
[0m$ [0mpython3 - <<'EOF'
import random
COUNT = 6      # Config.ExtremeTide.count
GOLDEN = 0.30  # Config.Tides.Golden.odds = { {"Golden", 30} }
TRIALS = 200_000
rng = random.Random(20261010)

# Lua: une chaine, meme vide, est VRAIE (seuls nil/false sont faux).
# Donc `mutations[1] and odds[1]` passe des que mutations[1] est une chaine.
def truthy(s):           # None = nil (faux), "" = vraie
    return s is not None

def roll_mut():          # Stats.RollMutation
    return "Golden" if rng.random() < GOLDEN else ""

def garantie(mut):       # SpawnReef, transcription exacte du Lua
    if (not any(m != "" for m in mut)) and truthy(mut[0]) and truthy([1]):
        mut[0] = "Golden"
    return mut

sans = avec = echec = 0
for _ in range(TRIALS):
    avant = [roll_mut() for _ in range(COUNT)]
    if not any(m != "" for m in avant):
        sans += 1
    apres = garantie(list(avant))
    if any(m != "" for m in apres):
        avec += 1
    else:
        echec += 1

print(f"AVANT : recifs sans espece mutee = {sans:>7} ({100*sans/TRIALS:5.2f} %)  [theorie 0.7^6 = {0.7**6:.4f}]")
print(f"APRES : recifs sans espece mutee = {echec:>7} ({100*echec/TRIALS:5.2f} %)")
print(f"especes Golden par recif (apres) = {avec/TRIALS:.3f}")
EOF
