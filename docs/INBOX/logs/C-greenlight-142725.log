import math
SEA_Y=0; COVE=70; CLIFF_OUTER=80; BHW=14
N=8
angs=[(i-1)*2*math.pi/N for i in range(1,N+1)]
def ang_to(x,z):
    r=math.hypot(x,z)
    if r<0.01: return math.inf
    a=math.atan2(z,x)
    return min(abs(math.atan2(math.sin(a-la),math.cos(a-la))) for la in angs)
def mat(x,z):
    r=math.hypot(x,z)
    if r>300: return "Sand"
    if r<=80:
        if r<=COVE: return "Sand"
        return "Sand" if ang_to(x,z)<math.atan2(BHW,r) else "Rock"
    return "Sand"

# Quelle fraction de l'anneau 70-150 est inevitably falaise (hors breche) ?
rock=0; tot=0
for i in range(2000):
    a=(i/2000)*2*math.pi
    for j in range(200):
        r=70+(150-70)*(j/199)
        tot+=1
        if mat(math.cos(a)*r, math.sin(a)*r)=="Rock": rock+=1
print(f"anneau 1 (70-150) : {100*rock/tot:.1f}% roche")
print(f"  dont falaise stricte 70-80 = {100*10/80:.1f}% de l'anneau")
# verif: si la falaise etait plus fine, combien reste-t-il de roche ?
for outer in (74,76,80):
    rk=0;t2=0
    for i in range(2000):
        a=(i/2000)*2*math.pi
        for j in range(200):
            r=70+(150-70)*(j/199); t2+=1
            rr=math.hypot(math.cos(a)*r,math.sin(a)*r)
            if rr<=outer and rr>COVE:
                if ang_to(math.cos(a)*r,math.sin(a)*r)>=math.atan2(BHW,rr): rk+=1
    print(f"  falaise jusqu'a {outer} : {100*rk/t2:.1f}% roche sur l'anneau 1")
