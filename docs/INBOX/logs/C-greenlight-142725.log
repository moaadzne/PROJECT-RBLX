}
-- Direction dans laquelle AVANCE la vague "venue du" nord, de l'est... (N = venue de -Z, avance vers +Z)
Config.WaveTravel = {
	N = Vector3.new(0, 0, 1),
	S = Vector3.new(0, 0, -1),
	E = Vector3.new(-1, 0, 0),
	W = Vector3.new(1, 0, 0),
}

