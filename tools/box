#!/bin/zsh
# tools/box — envoie un message a une autre session OpenCode.
#
# Le CLI d'OpenCode n'etait pas dans le PATH : il est livre avec l'app.
# C'est lui qui expose `run --session <id>`, le seul canal officiel pour
# parler a une session qui n'est pas un sous-agent de la notre.
#
# Usage :
#   tools/box list                       liste les sessions du repo
#   tools/box send <lettre|id> "message"  envoie a une session
#   tools/box bg <lettre|id> "message"   envoie sans attendre la reponse
#
# Lettres reconnues : A a V (via docs/INBOX/REGISTRE.md, la meme source que tools/pont).
set -euo pipefail

BIN="$HOME/Library/Application Support/ai.opencode.desktop/cli/2.0.26/opencode-cli"
REPO="$HOME/Documents/claude code/tide-rush"
REGISTRE="$REPO/docs/INBOX/REGISTRE.md"

[ -x "$BIN" ] || { echo "CLI introuvable : $BIN" >&2; exit 1; }
cd "$REPO"

# Resout une lettre en ID de session. Ordre : id direct, puis REGISTRE, puis titre.
resolve() {
  local want="$1"
  local list id

  if [[ "$want" == ses_* ]]; then
    print -r -- "$want"
    return 0
  fi

  # Le REGISTRE est la source de verite (meme table que tools/pont).
  if [[ -f "$REGISTRE" ]]; then
    id=$(grep -E "^\| *${want} *\|" "$REGISTRE" | grep -oE 'ses_[A-Za-z0-9]+' | head -1)
    if [[ -n "$id" ]]; then
      print -r -- "$id"
      return 0
    fi
  fi

  # Repli : la lettre dans le titre de session ("Tide Rush · A", ...).
  list=$("$BIN" session list 2>/dev/null || true)
  id=$(print -r -- "$list" \
    | grep -iE "· *${want}( |$)|Tide Rush ${want}\b|Session ${want}\b" \
    | head -1 | cut -f1)

  if [[ -z "$id" ]]; then
    echo "Lettre '$want' introuvable (ni dans docs/INBOX/REGISTRE.md, ni dans les titres)." >&2
    echo "Lettres connues :" >&2
    grep -oE '^\| *[A-Z] *\|' "$REGISTRE" 2>/dev/null | tr -d '| ' | tr '\n' ' ' >&2
    echo >&2
    return 1
  fi
  print -r -- "$id"
}

case "${1:-}" in
  list)
    "$BIN" session list
    ;;

  send|bg)
    mode="$1"; shift
    target="$1"; shift
    msg="$*"

    [[ -z "$msg" ]] && { echo "Message vide." >&2; exit 1; }

    id=$(resolve "$target")
    echo "-> $id" >&2

    if [[ "$mode" == bg ]]; then
      # stdout etendu dans un log, on ne bloque pas.
      log="docs/INBOX/logs/${target}-$(date +%H%M%S).log"
      mkdir -p docs/INBOX/logs
      ( "$BIN" run --session "$id" --print-logs "$msg" >"$log" 2>&1 ) &
      echo "envoye en arriere-plan, log : $log" >&2
    else
      "$BIN" run --session "$id" --print-logs "$msg"
    fi
    ;;

  *)
    sed -n '2,14p' "$0"
    exit 1
    ;;
esac
