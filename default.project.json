        "$path": { "optional": "src/ReplicatedStorage/Remotes" },
        "$ignoreUnknownInstances": true
      }
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts",
        "$ignoreUnknownInstances": true
      }
    },
    "StarterGui": {
      "$path": { "optional": "src/StarterGui" },
      "$ignoreUnknownInstances": true
    },
    "ReplicatedFirst": {
      "$path": { "optional": "src/ReplicatedFirst" },
      "$ignoreUnknownInstances": true
    }
  }
}
